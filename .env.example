# GEMINI_API_KEY: Required for Gemini AI API calls on client-side.
GEMINI_API_KEY=

# GOOGLE_GENAI_API_KEY: Required for Gemini AI API calls on server-side.
GOOGLE_GENAI_API_KEY=

# SESSION_SECRET: Secret for cookie session.
SESSION_SECRET=

# GOOGLE_CLIENT_ID: Required for Google OAuth.
GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET: Required for Google OAuth.
GOOGLE_CLIENT_SECRET=

# MONGODB_URI: Optional MongoDB connection string.
MONGODB_URI=

# APP_URL: The URL where this applet is hosted.
APP_URL=
